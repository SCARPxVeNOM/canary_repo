{
  "name": "canary-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Canary: answers a dapp's RPC reads through anon-rpc, blocks third-party requests carrying your address, and measures coverage.",
  "scripts": {
    "build": "node build.mjs",
    "build:live": "node build.mjs --config config/live.json",
    "test": "npm run test:unit && node test/e2e.mjs",
    "test:unit": "node --test test/pipeline.test.mjs test/ens.test.mjs",
    "test:ens-live": "node test/ens-live.mjs",
    "snapshot": "node scripts/fetch-tor-bootstrap.mjs"
  },
  "dependencies": {
    "@anon-rpc/browser-extension-harness": "0.4.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@noble/hashes": "^1.8.0",
    "@tailwindcss/node": "^4.3.4",
    "@tailwindcss/oxide": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "viem": "^2.57.0"
  }
}
