{
  "name": "@ayush_saklani/canary-gateway",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Canary Gateway: a local JSON-RPC endpoint and HTTP(S) proxy that sends an agent's chain reads through anon-rpc and enforces its privacy manifest.",
  "keywords": [
    "ethereum",
    "privacy",
    "tor",
    "anon-rpc",
    "json-rpc",
    "proxy",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCARPxVeNOM/canary_repo.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/SCARPxVeNOM/canary_repo/tree/main/packages/gateway#readme",
  "bugs": {
    "url": "https://github.com/SCARPxVeNOM/canary_repo/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "canary-gateway": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-page.mjs",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@ayush_saklani/canary-core": "0.1.0",
    "playwright-core": "^1.56.0",
    "viem": "^2.57.0",
    "ws": "^8.18.0",
    "@ayush_saklani/canary-ens": "0.1.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "esbuild": "^0.28.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "@types/node-forge": "^1.3.11"
  }
}
