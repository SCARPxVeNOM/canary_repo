{
  "name": "@ayush_saklani/canary-agent",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "In-process Canary SDK for TypeScript agents: viem transport, fetch, and an LLM prompt pseudonymizer, enforced by a Canary Gateway.",
  "keywords": [
    "ethereum",
    "privacy",
    "anon-rpc",
    "viem",
    "ethers",
    "llm",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCARPxVeNOM/canary_repo.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/SCARPxVeNOM/canary_repo/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/SCARPxVeNOM/canary_repo/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ayush_saklani/canary-core": "0.1.0",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@ayush_saklani/canary-gateway": "0.1.0",
    "ethers": "^6.13.0"
  },
  "peerDependenciesMeta": {
    "@ayush_saklani/canary-gateway": {
      "optional": true
    },
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ayush_saklani/canary-gateway": "0.1.0",
    "ethers": "^6.13.0"
  }
}
