From 3bd3a108a6bfa06b2728d964f90e391ebd6855c0 Mon Sep 17 00:00:00 2001
From: SCARPxVeNOM <pratikkumar56778@gmail.com>
Date: Fri, 6 Nov 2026 07:48:17 +0530
Subject: [PATCH] fix: drop a gateway that stops answering instead of waiting
 for the transport

A gateway that vanishes without closing its connection (crash, power,
network) sends nothing, so the client only learned it was gone when the
WebRTC transport timed out (~20-30 s); every tunnel through it hung until
then. Ping a gateway only when it has gone quiet while owing us bytes
(tunnel bytes sent, nothing back for 2 s), with a one-round-trip
GET /metadata.json (KpsGateway.ping). After 2 missed pings in a row (3 s
each), cool it off and drop its connection (KpsGateway.reset), so its
tunnels close at once and arti rebuilds through another gateway. Gateways
whose traffic flows, or that are idle, are never pinged. Relay choice is
unchanged.

With 3 gateways, killing the busiest (6 kills): 1 failed read per kill
(was 2), reads normal again after 10.5-14 s in 5 of 6 kills (once
31.5 s); was 17-31 s.
---
 src/kpsGateway.ts                 | 102 +++++++++++++++++++++++++++---
 src/socketProvider.ts             |  73 ++++++++++++++++++++-
 test/unit/socketProvider.test.mjs |  93 ++++++++++++++++++++++++++-
 3 files changed, 256 insertions(+), 12 deletions(-)

diff --git a/src/kpsGateway.ts b/src/kpsGateway.ts
index 2333b92..ac6540a 100644
--- a/src/kpsGateway.ts
+++ b/src/kpsGateway.ts
@@ -290,6 +290,82 @@ export class KpsGateway {
     }
   }
 
+  /** When tunnel bytes were first sent with nothing received since (ms epoch). */
+  #awaitingSince: number | null = null;
+
+  /**
+   * How long the gateway has been silent while owing us bytes: ms since
+   * tunnel bytes were sent with nothing received on any tunnel since; 0 if
+   * it isn't. A long silence is a reason to {@link ping}, not proof of death:
+   * the target may just be slow.
+   */
+  silentMs(now = Date.now()): number {
+    return this.#awaitingSince === null ? 0 : now - this.#awaitingSince;
+  }
+
+  #sent(): void {
+    this.#awaitingSince ??= Date.now();
+  }
+
+  #received(): void {
+    this.#awaitingSince = null;
+  }
+
+  /**
+   * One round trip on the current connection: resolves when the gateway
+   * answers a request head (any status; an older gateway may 404). Used as a
+   * liveness check — a gateway that vanished sends no close, so its
+   * connection otherwise looks open until the transport gives up. An answer
+   * ends the current silence (see {@link silentMs}).
+   */
+  async ping(opts: { signal?: AbortSignal } = {}): Promise<void> {
+    const { signal } = opts;
+    let stream: Stream | undefined;
+    let reader: ReadableStreamDefaultReader<Uint8Array> | undefined;
+    const release = () => {
+      reader?.cancel().catch(() => {});
+      stream?.close().catch(() => {});
+    };
+    try {
+      // The deadline covers every step: on a vanished peer even opening a
+      // stream may never settle.
+      await abortRace(
+        (async () => {
+          const conn = await this.#connection(signal);
+          stream = await this.#openStream(conn, signal);
+          if (signal?.aborted) return release();
+          reader = stream.readable.getReader();
+          const writer = stream.writable.getWriter();
+          await writer.write(enc.encode(`GET /metadata.json HTTP/1.1\r\nHost: ${this.#certhash}\r\n\r\n`));
+          await writer.close();
+          await readHead(reader);
+          this.#received();
+        })(),
+        signal,
+        () => timedOut(`ping ${this.#address}`),
+      );
+    } finally {
+      release();
+    }
+  }
+
+  /**
+   * Drop the current connection (it stopped answering): every tunnel and
+   * exchange on it is torn down now rather than when the transport notices.
+   * The gateway stays usable; the next call dials again.
+   */
+  reset(): void {
+    const p = this.#connPromise;
+    this.#connPromise = null;
+    this.#awaitingSince = null;
+    p?.then((conn) => {
+      const teardowns = this.#teardowns.get(conn);
+      this.#teardowns.delete(conn);
+      for (const fn of teardowns ?? []) fn();
+      conn.close();
+    }).catch(() => {});
+  }
+
   /**
    * Open a TCP tunnel to a Tor relay via CONNECT (PROTOCOL.md §4). After
    * the gateway's 200 the stream is the raw byte pipe to the target.
@@ -329,21 +405,31 @@ export class KpsGateway {
     }
 
     // The CONNECT exchange is done; hand the raw tunnel to the consumer as
-    // WHATWG streams. Release the writer we used for the request line so
-    // ArtiSocket.writable is available; keep `reader` (it holds any body
-    // bytes that arrived with the head) and expose it, extra bytes first,
-    // as a pull-based readable that only pulls from the network on demand.
-    writer.releaseLock();
+    // WHATWG streams. Keep `reader` (it holds any body bytes that arrived
+    // with the head) and expose it, extra bytes first, as a pull-based
+    // readable that only pulls from the network on demand. Both directions
+    // note activity for the liveness check (see silentMs).
+    const writable = new WritableStream<Uint8Array>({
+      write: (chunk) => {
+        this.#sent();
+        return writer.write(chunk);
+      },
+      close: () => writer.close(),
+      abort: (reason) => writer.abort(reason),
+    });
 
     const readable = new ReadableStream<Uint8Array>({
       start(controller) {
         if (head.extra.length) controller.enqueue(new Uint8Array(head.extra));
       },
-      async pull(controller) {
+      pull: async (controller) => {
         try {
           const { done, value } = await reader.read();
           if (done) controller.close(); // server FIN — target closed its write half
-          else if (value?.length) controller.enqueue(new Uint8Array(value));
+          else if (value?.length) {
+            this.#received();
+            controller.enqueue(new Uint8Array(value));
+          }
         } catch (e) {
           controller.error(e);
         }
@@ -372,7 +458,7 @@ export class KpsGateway {
 
     return new ArtiSocket({
       readable,
-      writable: stream.writable,
+      writable,
       closed,
       closeWrite: () => stream.closeWrite(),
       close: () => { stream.close().catch(() => {}); },
diff --git a/src/socketProvider.ts b/src/socketProvider.ts
index 1fa92a9..25d8c62 100644
--- a/src/socketProvider.ts
+++ b/src/socketProvider.ts
@@ -43,12 +43,32 @@ export interface GatewayTiming {
   cooldownBaseMs: number;
   /** Ceiling on the cooldown. */
   cooldownMaxMs: number;
+  /** How often a gateway carrying tunnels is looked at; 0 disables the liveness check. */
+  livenessCheckMs: number;
+  /** Silence (bytes sent, nothing received) after which a gateway is pinged. */
+  suspectAfterMs: number;
+  /** Deadline for one ping. */
+  pingTimeoutMs: number;
+  /** Consecutive missed pings before the gateway's connection is dropped. */
+  pingMisses: number;
 }
 
 const DEFAULT_TIMING: GatewayTiming = {
   attemptTimeoutMs: 15_000,
   cooldownBaseMs: 2_000,
   cooldownMaxMs: 60_000,
+  // A gateway that dies without closing (crash, power, network) leaves its
+  // tunnels hanging until the transport times out, ~20-30 s for WebRTC; Arti
+  // only rebuilds circuits once their channels close. A gateway is pinged
+  // only when it has gone quiet while owing us bytes (nothing at all comes
+  // back over any of its tunnels for 2 s after a send), and dropped after two
+  // missed 3 s pings: ~6-9 s after it died. Traffic that flows, or an idle
+  // gateway, costs no pings. Generous on purpose: dropping a slow but working
+  // gateway tears down every circuit through it.
+  livenessCheckMs: 1_000,
+  suspectAfterMs: 2_000,
+  pingTimeoutMs: 3_000,
+  pingMisses: 2,
 };
 
 /** Liveness and load bookkeeping for one configured gateway. */
@@ -60,6 +80,10 @@ interface GatewayState {
   failures: number;
   /** Epoch ms before which this gateway is passed over. */
   notBefore: number;
+  /** Consecutive missed liveness checks. */
+  misses: number;
+  /** Liveness check timer, running while the gateway carries tunnels. */
+  watch?: ReturnType<typeof setInterval>;
 }
 
 /**
@@ -250,6 +274,7 @@ export class ArtiSocketProvider {
         inFlight: 0,
         failures: 0,
         notBefore: 0,
+        misses: 0,
       });
     }
     this.#strategies = options.strategies ?? defaultStrategies(this.#states.length > 0);
@@ -334,7 +359,52 @@ export class ArtiSocketProvider {
 
   /** Close all KPS gateway connections and release resources. */
   close(): void {
-    for (const s of this.#states) s.gw.close();
+    for (const s of this.#states) {
+      this.#unwatch(s);
+      s.gw.close();
+    }
+  }
+
+  /**
+   * While a gateway carries tunnels, ping it when it goes quiet (see
+   * `GatewayTiming`). After `pingMisses` misses in a row, cool it off and
+   * drop its connection, so its tunnels close now and Arti rebuilds their
+   * circuits through another gateway. Relay choice is untouched: the same
+   * targets are reached through whichever gateway is up.
+   */
+  #watch(s: GatewayState): void {
+    const { livenessCheckMs, suspectAfterMs, pingTimeoutMs, pingMisses } = this.#timing;
+    if (!livenessCheckMs || s.watch) return;
+    let busy = false;
+    const check = (): void => {
+      if (busy) return;
+      if (s.inFlight === 0) return this.#unwatch(s);
+      if (!s.misses && s.gw.silentMs() < suspectAfterMs) return;
+      busy = true;
+      s.gw.ping({ signal: AbortSignal.timeout(pingTimeoutMs) }).then(
+        () => {
+          s.misses = 0;
+          busy = false;
+        },
+        () => {
+          busy = false;
+          s.misses += 1;
+          if (s.misses < pingMisses) return check(); // again at once, not a tick later
+          this.#unwatch(s);
+          this.#onFailure(s);
+          s.gw.reset();
+        },
+      );
+    };
+    s.watch = setInterval(check, livenessCheckMs);
+    // Node: never hold the process open just for the check.
+    (s.watch as { unref?: () => void }).unref?.();
+  }
+
+  #unwatch(s: GatewayState): void {
+    clearInterval(s.watch);
+    s.watch = undefined;
+    s.misses = 0;
   }
 
   // -- Direct TCP strategy (Node.js / Deno) ---------------------------------
@@ -383,6 +453,7 @@ export class ArtiSocketProvider {
         // a gateway carrying many live tunnels reads as busy.
         const release = () => { s.inFlight -= 1; };
         sock.closed.then(release, release);
+        this.#watch(s);
         return sock;
       } catch (e: any) {
         s.inFlight -= 1;
diff --git a/test/unit/socketProvider.test.mjs b/test/unit/socketProvider.test.mjs
index bae1d02..ca1c652 100644
--- a/test/unit/socketProvider.test.mjs
+++ b/test/unit/socketProvider.test.mjs
@@ -38,19 +38,25 @@ before(async () => {
 const enc = new TextEncoder()
 const OK_HEAD = 'HTTP/1.1 200 OK\r\n\r\n'
 
-/** A fake KPS stream that replays `head` (+ optional body) to the reader. */
-function makeStream({ head = OK_HEAD, body = null, endAfterHead = false } = {}) {
+/**
+ * A fake KPS stream that replays `head` (+ optional body) to the reader. With
+ * `echo`, tunnel bytes written after the request line come back.
+ */
+function makeStream({ head = OK_HEAD, body = null, endAfterHead = false, echo = false } = {}) {
   let settle
+  let ctl
+  let writes = 0
   const closed = new Promise((r) => { settle = r })
   return {
     readable: new ReadableStream({
       start(c) {
+        ctl = c
         c.enqueue(enc.encode(head))
         if (body) c.enqueue(body)
         if (endAfterHead) c.close()
       },
     }),
-    writable: new WritableStream({ write() {} }),
+    writable: new WritableStream({ write(chunk) { if (echo && writes++ > 0) ctl.enqueue(chunk) } }),
     closed,
     closeWrite: async () => {},
     close: async () => settle({ ok: true }),
@@ -75,6 +81,7 @@ function makeDial(behaviours) {
       openStream: async () => {
         b.opens = (b.opens ?? 0) + 1
         if (b.openMode === 'reject') throw new Error('openStream refused')
+        if (b.openMode === 'hang') return new Promise(() => {})
         return makeStream(b.stream)
       },
       closed,
@@ -311,3 +318,83 @@ describe('gatewayFetch (fast bootstrap)', () => {
     await assert.rejects(() => provider.gatewayFetch('/bootstrap.zip.zst'), /no gateway configured/)
   })
 })
+
+describe('liveness check', () => {
+  const quick = { livenessCheckMs: 10, suspectAfterMs: 30, pingTimeoutMs: 40, pingMisses: 2, attemptTimeoutMs: 200 }
+  const sleep = (ms) => new Promise((r) => setTimeout(r, ms))
+  const send = async (sock) => {
+    const w = sock.writable.getWriter()
+    await w.write(enc.encode('cell'))
+    w.releaseLock()
+  }
+
+  test('tunnels through a gateway that stops answering are closed, and new ones go elsewhere', async () => {
+    const { provider, behaviours } = setup([ADDRS[0], ADDRS[1]], { timing: quick })
+    const keepAlive = setTimeout(() => {}, 30_000)
+    try {
+      const dead = primaryOf(provider) // asked before connecting: least-outstanding reorders after
+      const sock = await provider.connect('198.51.100.1:9001')
+      behaviours[dead].openMode = 'hang' // the gateway vanished: nothing answers, nothing closes
+      const started = Date.now()
+      await send(sock) // owed an answer that never comes
+      await sock.closed
+      const elapsed = Date.now() - started
+      assert.ok(elapsed < 1_000, `tunnel stayed open ${elapsed}ms after the gateway died`)
+      await provider.connect('198.51.100.1:9001')
+      assert.ok(behaviours[otherThan([ADDRS[0], ADDRS[1]], dead)[0]].opens >= 1, 'the new tunnel went to the live gateway')
+    } finally {
+      clearTimeout(keepAlive)
+      provider.close()
+    }
+  })
+
+  test('a gateway whose tunnels carry traffic both ways is never pinged', async () => {
+    const { provider, behaviours } = setup([ADDRS[0]], { timing: quick })
+    behaviours[ADDRS[0]].stream = { echo: true }
+    try {
+      const sock = await provider.connect('198.51.100.1:9001')
+      const reader = sock.readable.getReader()
+      for (let i = 0; i < 15; i++) {
+        await send(sock)
+        await reader.read()
+        await sleep(20)
+      }
+      assert.equal(behaviours[ADDRS[0]].opens, 1, 'only the tunnel itself')
+    } finally {
+      provider.close()
+    }
+  })
+
+  test('a quiet gateway that answers its ping keeps its tunnels', async () => {
+    const { provider, behaviours } = setup([ADDRS[0]], { timing: quick })
+    const keepAlive = setTimeout(() => {}, 30_000)
+    try {
+      const sock = await provider.connect('198.51.100.1:9001')
+      let closed = false
+      sock.closed.then(() => { closed = true })
+      for (let i = 0; i < 3; i++) {
+        await send(sock) // the target is slow: nothing comes back
+        await sleep(100)
+      }
+      assert.equal(closed, false)
+      assert.ok(behaviours[ADDRS[0]].opens > 1, 'pinged once it went quiet')
+      assert.ok(behaviours[ADDRS[0]].opens <= 4, 'one ping per silence, not one per tick')
+      assert.equal(behaviours[ADDRS[0]].dials, 1, 'no redial')
+    } finally {
+      clearTimeout(keepAlive)
+      provider.close()
+    }
+  })
+
+  test('an idle gateway, or one without tunnels, is not pinged', async () => {
+    const { provider, behaviours } = setup([ADDRS[0]], { timing: quick })
+    const sock = await provider.connect('198.51.100.1:9001')
+    await sleep(150)
+    assert.equal(behaviours[ADDRS[0]].opens, 1, 'tunnel open but nothing owed')
+    await send(sock)
+    sock.close()
+    await sleep(150)
+    assert.equal(behaviours[ADDRS[0]].opens, 1, 'no tunnels left')
+    provider.close()
+  })
+})
