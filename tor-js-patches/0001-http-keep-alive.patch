+
+/// Where a connection may be reused: same isolation key (None = unkeyed),
+/// scheme, host and port. Never across keys: that would put two keys'
+/// requests on one circuit and one TLS session.
+type PoolKey = (Option<String>, String, String, u16);
+type PooledConn = Rc<RefCell<fetch::BoxedConn>>;
+
+/// A connection idle longer than this may have been closed by the server.
+const POOL_IDLE_MS: f64 = 30_000.0;
+/// Arti stops putting new streams on a circuit after ~10 min; a pooled
+/// connection would keep an old circuit in use, so it is retired as well.
+const POOL_MAX_AGE_MS: f64 = 600_000.0;
+const POOL_PER_KEY: usize = 4;
+
+/// HTTP/1.1 keep-alive connections, kept per `PoolKey` after their response
+/// body has been read to the end.
+#[derive(Default)]
+struct ConnPool {
+    idle: HashMap<PoolKey, Vec<(PooledConn, f64, f64)>>, // (conn, created, idle since)
+}
+
+impl ConnPool {
+    fn take(&mut self, key: &PoolKey, now: f64) -> Option<(PooledConn, f64)> {
+        let list = self.idle.get_mut(key)?;
+        while let Some((conn, created, idle_since)) = list.pop() {
+            if now - idle_since < POOL_IDLE_MS && now - created < POOL_MAX_AGE_MS {
+                return Some((conn, created));
+            }
+        }
+        None
+    }
+
+    fn put(&mut self, key: PoolKey, conn: PooledConn, created: f64, now: f64) {
+        if now - created >= POOL_MAX_AGE_MS {
+            return;
+        }
+        let list = self.idle.entry(key).or_default();
+        if list.len() < POOL_PER_KEY {
+            list.push((conn, created, now));
+        }
+    }
+}
+
+/// Handed to a response body: puts the connection back once the body ends.
+struct Release {
+    pool: Rc<RefCell<ConnPool>>,
+    key: PoolKey,
+    conn: PooledConn,
+    created: f64,
 }
 
