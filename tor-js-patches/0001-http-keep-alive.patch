+/// Handed to a response body: puts the connection back if the body ends
+/// exactly at its framed end.
+struct Release {
+    pool: Rc<RefCell<ConnPool>>,
+    key: PoolKey,
+    conn: PooledConn,
+    created: f64,
+    limit: f64,
 }
 
