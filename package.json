{
  "name": "canary-agents",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Canary for agents: @ayush_saklani/canary-core, @ayush_saklani/canary-gateway and @ayush_saklani/canary-agent (see docs/agent-sdk.md). The browser extension in extension/ builds on its own.",
  "workspaces": [
    "packages/core",
    "packages/ens",
    "packages/gateway",
    "packages/agent",
    "examples/viem-agent"
  ],
  "scripts": {
    "build": "npm run build -w @ayush_saklani/canary-core -w @ayush_saklani/canary-ens -w @ayush_saklani/canary-gateway -w @ayush_saklani/canary-agent && npm rebuild @ayush_saklani/canary-gateway @ayush_saklani/canary-ens",
    "test": "npm test -w @ayush_saklani/canary-core -w @ayush_saklani/canary-ens -w @ayush_saklani/canary-gateway -w @ayush_saklani/canary-agent",
    "gateways": "node scripts/set-gateways.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
